<Page x:Class="AutoService.Wpf.Pages.CarsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Автомобили"
      Background="{StaticResource PageBackground}">
    <Grid Margin="23,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Button Content="Назад" Style="{StaticResource BackButtonStyle}" Click="Back_Click" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,20,0"/>
            <StackPanel><TextBlock Text="Автомобили" Style="{StaticResource PageTitle}"/><TextBlock Text="Карточки автомобилей и контакты владельцев." Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <ListView x:Name="CarsList" Grid.Row="1" Style="{StaticResource ItemCardList}" SelectionChanged="CarsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding PlateNumber}" FontSize="15" FontWeight="SemiBold" Foreground="Black"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="Марка: "/><Run Text="{Binding Brand}"/><Run Text="   Модель: "/><Run Text="{Binding Model}"/></TextBlock>
                            <TextBlock Margin="0,3,0,0"><Run Text="VIN: "/><Run Text="{Binding Vin}"/></TextBlock>
                            <TextBlock Margin="0,3,0,0"><Run Text="Владелец: "/><Run Text="{Binding OwnerName}"/><Run Text="   Телефон: "/><Run Text="{Binding OwnerPhone}"/></TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border Grid.Row="2" Style="{StaticResource WhiteCard}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Выберите автомобиль для изменения" FontSize="15" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,8,0,6">
                    <StackPanel Width="146"><TextBlock Text="Госномер"/><TextBox x:Name="PlateBox"/></StackPanel>
                    <StackPanel Width="146"><TextBlock Text="Марка"/><TextBox x:Name="BrandBox"/></StackPanel>
                    <StackPanel Width="146"><TextBlock Text="Модель"/><TextBox x:Name="ModelBox"/></StackPanel>
                    <StackPanel Width="195"><TextBlock Text="VIN"/><TextBox x:Name="VinBox"/></StackPanel>
                    <StackPanel Width="205"><TextBlock Text="Владелец"/><TextBox x:Name="OwnerBox"/></StackPanel>
                    <StackPanel Width="165"><TextBlock Text="Телефон"/><TextBox x:Name="PhoneBox"/></StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Сохранить изменения" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
                    
                    
                </WrapPanel>
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" Foreground="Black"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
