<Page x:Class="AutoService.Wpf.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Сотрудники"
      Background="{StaticResource PageBackground}">
    <Grid Margin="23,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Button Content="Назад" Style="{StaticResource BackButtonStyle}" Click="Back_Click" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,20,0"/>
            <StackPanel><TextBlock Text="Сотрудники" Style="{StaticResource PageTitle}"/><TextBlock Text="Администратор добавляет новых механиков и просматривает их результаты." Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource WhiteCard}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Новый механик" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                <WrapPanel>
                    <StackPanel Width="245"><TextBlock Text="ФИО"/><TextBox x:Name="FullNameBox"/></StackPanel>
                    <StackPanel Width="185"><TextBlock Text="Логин"/><TextBox x:Name="LoginBox"/></StackPanel>
                    <StackPanel Width="185"><TextBlock Text="Пароль"/><PasswordBox x:Name="PasswordBox"/></StackPanel>
                    <Button Content="Добавить механика" Click="Create_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
                </WrapPanel>
                <TextBlock Text="Пароль сохраняется сервером только в виде хеша." Foreground="Black"/>
                <TextBlock x:Name="MessageText" Foreground="Black" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <ListView x:Name="UsersList" Grid.Row="2" Style="{StaticResource ItemCardList}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="SemiBold" Foreground="Black"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="ID: "/><Run Text="{Binding Id}"/><Run Text="   Логин: "/><Run Text="{Binding Login}"/><Run Text="   Роль: "/><Run Text="{Binding Role}"/></TextBlock>
                            <TextBlock Margin="0,5,0,0"><Run Text="Хороших работ: "/><Run Text="{Binding GoodWorksCount}"/><Run Text="   Подтверждённых ошибок: "/><Run Text="{Binding BadWorksCount}"/></TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
