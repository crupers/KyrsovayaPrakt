<Page x:Class="AutoService.Wpf.Pages.RepairsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="История ремонтов"
      Background="{StaticResource PageBackground}">
    <Grid Margin="23,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Button Content="Назад" Style="{StaticResource BackButtonStyle}" Click="Back_Click" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,20,0"/>
            <StackPanel><TextBlock Text="История ремонтов" Style="{StaticResource PageTitle}"/><TextBlock Text="Выберите ремонт, чтобы увидеть исполнителей и выполненные операции." Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Поиск по госномеру" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="PlateFilter" Width="180"/>
            <Button Content="Найти" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
            <Button Content="Все ремонты" Style="{StaticResource BackButtonStyle}" Click="All_Click"/>
        </WrapPanel>
        <ListView x:Name="RepairsList" Grid.Row="2" Style="{StaticResource ItemCardList}" SelectionChanged="RepairsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="Black"><Run Text="Ремонт № "/><Run Text="{Binding Id}"/><Run Text="  ·  "/><Run Text="{Binding PlateNumber}"/></TextBlock>
                            <TextBlock Margin="0,4,0,0"><Run Text="Марка: "/><Run Text="{Binding Brand}"/><Run Text="   Организация: "/><Run Text="{Binding Organization}"/></TextBlock>
                            <TextBlock Margin="0,3,0,0"><Run Text="Статус: "/><Run Text="{Binding StatusDisplay}"/><Run Text="   Дата: "/><Run Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"/></TextBlock>
                            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"><Run Text="Причина обращения: "/><Run Text="{Binding ProblemDescription}"/></TextBlock>
                            <TextBlock Margin="0,3,0,0"><Run Text="Предыдущий ремонт: "/><Run Text="{Binding PreviousRepairId}"/></TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Text="Работы выбранного ремонта" FontSize="15" FontWeight="SemiBold" Foreground="Black" Margin="0,12,0,8"/>
        <ListView x:Name="WorksList" Grid.Row="4" Style="{StaticResource ItemCardList}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,7">
                        <StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="Механик: "/><Run Text="{Binding WorkerName}"/><Run Text="   Запчасти: "/><Run Text="{Binding InstalledParts}"/></TextBlock>
                            <TextBlock Margin="0,3,0,0"><Run Text="Проверка: "/><Run Text="{Binding QualityDisplay}"/></TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
